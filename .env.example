# Copy this file to .env and fill in real values for local development.
# All values below are placeholders for a fictional portfolio project.

# --- Database ---
POSTGRES_USER=opstrack
POSTGRES_PASSWORD=change_me
POSTGRES_DB=opstrack
POSTGRES_HOST=db
POSTGRES_PORT=5432

DATABASE_URL=postgresql+psycopg://opstrack:change_me@db:5432/opstrack

# --- Backend / FastAPI ---
BACKEND_CORS_ORIGINS=["http://localhost:5173"]
